<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Reproducibility isolation for the benchmark harness.

    Scoring must not depend on the machine that runs it. Without this file, a generated run that
    ships no nuget.config of its own inherits the scorer's global/user NuGet config (e.g. a local
    Trellis dev feed such as `C:\nuget`); if that source is absent on the scoring machine, restore
    fails with NU1301 and the run scores ~0 for reasons unrelated to the generated code.

    `<clear />` drops every inherited (parent / per-user / per-machine) source; we then restore from
    nuget.org only, which serves both the public packages and the Trellis *-alpha packages (the
    with-trellis runs restore Trellis 3.0.0-alpha.* from nuget.org with exactly this configuration).
    Runs that ship their own nuget.config still use it (it sits nearer the project); this file only
    covers runs that ship none.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
